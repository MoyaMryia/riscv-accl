diff --git a/src/models/qwen35.cpp b/src/models/qwen35.cpp
index c9a3f4b..27bd36f 100644
--- a/src/models/qwen35.cpp
+++ b/src/models/qwen35.cpp
@@ -114,7 +114,13 @@ void llama_model_qwen35::load_arch_tensors(llama_model_loader & ml) {
         layer.nextn.enorm            = create_tensor(tn(LLM_TENSOR_NEXTN_ENORM,            "weight", il), { n_embd },              0);
         layer.nextn.hnorm            = create_tensor(tn(LLM_TENSOR_NEXTN_HNORM,            "weight", il), { n_embd },              0);
         layer.nextn.embed_tokens     = create_tensor(tn(LLM_TENSOR_NEXTN_EMBED_TOKENS,     "weight", il), { n_embd, n_vocab },     TENSOR_NOT_REQUIRED);
-        layer.nextn.shared_head_head = create_tensor(tn(LLM_TENSOR_NEXTN_SHARED_HEAD_HEAD, "weight", il), { n_embd, n_vocab },     TENSOR_NOT_REQUIRED);
+        // allow a truncated draft-vocab head [n_embd, n_vocab_dft], n_vocab_dft <= n_vocab.
+        // the draft then only proposes tokens from a prefix of the vocab (lossless: verify is full-vocab),
+        // and graph_mtp pads the logits with -inf back to full width.
+        const std::string shh_name = tn(LLM_TENSOR_NEXTN_SHARED_HEAD_HEAD, "weight", il).str();
+        const ggml_tensor * shh_meta = ml.get_tensor_meta(shh_name.c_str());
+        const int64_t n_vocab_shh = shh_meta ? shh_meta->ne[1] : n_vocab;
+        layer.nextn.shared_head_head = create_tensor(tn(LLM_TENSOR_NEXTN_SHARED_HEAD_HEAD, "weight", il), { n_embd, n_vocab_shh }, TENSOR_NOT_REQUIRED);
         layer.nextn.shared_head_norm = create_tensor(tn(LLM_TENSOR_NEXTN_SHARED_HEAD_NORM, "weight", il), { n_embd },              TENSOR_NOT_REQUIRED);
     };
 
@@ -652,6 +658,16 @@ llama_model_qwen35::graph_mtp::graph_mtp(const llama_model & model, const llm_gr
     cur = build_lora_mm(head_w, cur, head_s);
     cb(cur, "result_output", -1);
 
+    // truncated draft-vocab head (e.g. 32k prefix rows): pad logits with -inf up to the full
+    // vocab so out-of-prefix tokens are never proposed. lossless: verify uses the full-vocab target.
+    const int64_t n_vocab_full = model.tok_embd->ne[1];
+    if (cur->ne[0] < n_vocab_full) {
+        ggml_tensor * pad = ggml_new_tensor_2d(ctx0, GGML_TYPE_F32, n_vocab_full - cur->ne[0], cur->ne[1]);
+        pad = ggml_fill(ctx0, pad, -INFINITY);
+        cur = ggml_concat(ctx0, cur, pad, /*dim=*/ 0);
+        cb(cur, "result_output_padded", -1);
+    }
+
     res->t_logits = cur;
     ggml_build_forward_expand(gf, cur);
 }
