# bootable kernel / initramfs are downloaded binaries, keep out of git
env/qemu/vmlinux-rv64
env/qemu/initramfs.cpio.gz
# lab/: 本机实验工件与可再生产物，只入库目录说明。
# TinyLlama 基线记录与 QEMU 测量工具属于另一项目，保留本机。
/lab/*
!/lab/README.md
/lab/plugin/

# python / editor artifacts
__pycache__/
*.pyc
# vendored or oversized trees, keep out of git
bianbu/
# 本机下载的模型仓库与第三方转换工具副本。
/TinyLlama/
/llamacpp-conv/
# 完整委员会成果目录由交付脚本生成，不把大型副本入库。
/final-release/
# LaTeX build artifacts
spacemit/reports/*.aux
spacemit/reports/*.log
spacemit/reports/*.out
# 技术指南放在 docs/ 下，导出中间文件不入库。
docs/**/*.aux
docs/**/*.log
docs/**/*.out
docs/**/*.toc
# generated frequency-rank domain map (rebuilt by make-domain-map.py)
spacemit/models/frspec/*.bin

