+        vfloat32m8_t accq = __riscv_vfmv_v_f_f32m8(0.0f, vlmax);
+        for (int64_t i = 0; i < S_v; ) {
+            const size_t vl = __riscv_vsetvl_e32m8(S_v - i);
+            vfloat32m8_t r = __riscv_vle32_v_f32m8(row + i, vl);
+            r = __riscv_vfmacc_vf_f32m8(r, dj, __riscv_vle32_v_f32m8(k_d + i, vl), vl);
+            __riscv_vse32_v_f32m8(row + i, r, vl);
+            accq = __riscv_vfmacc_vv_f32m8(accq, r, __riscv_vle32_v_f32m8(q_d + i, vl), vl);
+            i += vl;
+        }
+        const float sumq = __riscv_vfmv_f_s_f32m1_f32(__riscv_vfredusum_vs_f32m8_f32m1(
+                    accq, __riscv_vfmv_v_f_f32m1(0.0f, 1), vlmax));
+        attn_data[j] = sumq * scale;
+    }
