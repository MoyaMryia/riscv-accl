+                                     const float * q_d, float ge, float beta_val, float scale,
+                                     int64_t S_v, float * attn_data) {
+    const size_t vlmax = __riscv_vsetvlmax_e32m8();
+    for (int64_t j = 0; j < S_v; ++j) {
+        float * row = s_out + j * S_v;
+        vfloat32m8_t acck = __riscv_vfmv_v_f_f32m8(0.0f, vlmax);
+        for (int64_t i = 0; i < S_v; ) {
+            const size_t vl = __riscv_vsetvl_e32m8(S_v - i);
+            vfloat32m8_t r = __riscv_vle32_v_f32m8(row + i, vl);
