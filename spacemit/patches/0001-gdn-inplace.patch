+            __riscv_vse32_v_f32m8(row + i, r, vl);
+            acck = __riscv_vfmacc_vv_f32m8(acck, r, __riscv_vle32_v_f32m8(k_d + i, vl), vl);
+            i += vl;
+        }
+        const float sumk = __riscv_vfmv_f_s_f32m1_f32(__riscv_vfredusum_vs_f32m8_f32m1(
+                    acck, __riscv_vfmv_v_f_f32m1(0.0f, 1), vlmax));
