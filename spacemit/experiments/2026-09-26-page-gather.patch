+#pragma once
+
+#include <algorithm>
+#include <cstdint>
+#include <stdexcept>
+#include <vector>
+
+// Expand occupied 32-cell pages in physical order. A negative row marks
+// logical padding and must be masked even though the gather reads row zero.
+template <typename IsEmpty>
+std::vector<int32_t> llama_kv_page_rows(uint32_t size, IsEmpty is_empty, uint32_t padded_size = 0) {
+    std::vector<int32_t> rows;
+    constexpr uint32_t page_size = 32;
+    for (uint32_t base = 0; base < size; base += page_size) {
+        const uint32_t end = std::min(base + page_size, size);
+        bool occupied = false;
+        for (uint32_t cell = base; cell < end; ++cell) {
+            occupied |= !is_empty(cell);
+        }
+        if (occupied) {
+            for (uint32_t cell = base; cell < end; ++cell) {
+                rows.push_back(cell);
+            }
+        }
+    }
+    if (padded_size) {
+        if (rows.size() > padded_size) {
+            throw std::runtime_error("KV page map exceeds attention span");
+        }
+        rows.resize(padded_size, -1);
+    }
+    return rows;
+}
