+// Preserve physical order within and between pages. -1 marks masked padding;
+// gather inputs map it to row zero, but the attention mask never exposes it.
+std::vector<int32_t> llama_kv_cache::page_row_map(uint32_t padded_size) const {
+    GGML_ASSERT(page_gather && n_stream == 1);
+    const auto & cells = v_cells[0];
+    return llama_kv_page_rows(cells.size(), [&](uint32_t cell) {
+        return cells.is_empty(cell);
+    }, padded_size);
+}
+
+ggml_tensor * llama_kv_cache::build_input_page_rows(ggml_context * ctx, uint32_t n_kv) const {
+    if (!page_gather) {
+        return nullptr;
+    }
+    auto * rows = ggml_new_tensor_1d(ctx, GGML_TYPE_I32, n_kv);
+    ggml_set_name(rows, "kv_page_rows");
+    ggml_set_input(rows);
+    return rows;
+}
+
+void llama_kv_cache::set_input_page_rows(ggml_tensor * dst) const {
+    GGML_ASSERT(page_gather && ggml_backend_buffer_is_host(dst->buffer));
+    auto rows = page_row_map(dst->ne[0]);
+    for (auto & row : rows) {
+        row = std::max(row, 0);
+    }
+    ggml_backend_tensor_set(dst, rows.data(), 0, rows.size()*sizeof(int32_t));
+}
