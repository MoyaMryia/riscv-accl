+void forward_flash_attn_ext_f16_tiled_vlen1024_vf16(const ggml_compute_params * params,
+                                                    ggml_tensor * dst, int ir0, int ir1,
+                                                    void * tcm_buffer, size_t tcm_buffer_size) {
+    static const int rows = [] {
+        const char * env = std::getenv("SPINE_FA_K1_LAYOUT");
+        if (!env || !env[0] || strcmp(env, "0") == 0) return 0;
+        if (strcmp(env, "16") == 0) return 16;
+        if (strcmp(env, "32") == 0) return 32;
+        GGML_ABORT("SPINE_FA_K1_LAYOUT must be 0, 16 or 32");
+    }();
+    const bool eligible = rows && !params->use_ref && __riscv_vlenb() == 32 &&
+        dst->src[0]->type == GGML_TYPE_F32 && dst->src[1]->type == GGML_TYPE_F16 &&
+        dst->src[2]->type == GGML_TYPE_F16 && dst->src[1]->ne[0] == 256 &&
+        dst->src[2]->ne[0] == 256 && dst->src[0]->ne[1] >= 16;
+    if (eligible) {
+        static std::atomic<bool> logged { false };
+        if (!logged.exchange(true)) {
+            fprintf(stderr, "SPINE_FA_K1_LAYOUT: compact Q=%d KV=64 F16 scratch enabled\n", rows);
+        }
+        if (rows == 16) {
+            forward_flash_attn_ext_f16_tiled_impl<16, true>(params, dst, ir0, ir1, nullptr, 0);
+        } else {
+            forward_flash_attn_ext_f16_tiled_impl<32, true>(params, dst, ir0, ir1, nullptr, 0);
+        }
+    } else {
+        forward_flash_attn_ext_f16_tiled_impl<ggml_fa_tile_config::Q, false>(
+            params, dst, ir0, ir1, tcm_buffer, tcm_buffer_size);
     }
